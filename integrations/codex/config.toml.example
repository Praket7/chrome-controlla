# Add this block to ~/.codex/config.toml and replace the binary/state paths.
[mcp_servers.chrome-controlla]
command = "/absolute/path/to/controlla"
args = ["mcp"]
startup_timeout_sec = 20
tool_timeout_sec = 120

[mcp_servers.chrome-controlla.env]
CONTROLLA_STATE_DIR = "/absolute/path/to/controlla-state"
CONTROLLA_AGENT_SURFACE = "v3-compact"
CONTROLLA_BROWSER_MODE = "foreground"
