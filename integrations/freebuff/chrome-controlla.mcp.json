{
  "name": "chrome-controlla",
  "transport": "stdio",
  "command": "/absolute/path/to/controlla",
  "args": ["mcp"],
  "env": {
    "CONTROLLA_STATE_DIR": "/absolute/path/to/controlla-state",
    "CONTROLLA_AGENT_SURFACE": "v3-compact"
  },
  "session": {
    "lifetime": "client",
    "reuseProcess": true
  },
  "safety": {
    "explicitTargetAuthority": true,
    "unknownMutationRetry": false
  }
}
