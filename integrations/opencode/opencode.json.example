{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-controlla": {
      "type": "local",
      "command": ["/absolute/path/to/controlla", "mcp"],
      "enabled": true,
      "environment": {
        "CONTROLLA_STATE_DIR": "/absolute/path/to/controlla-state",
        "CONTROLLA_AGENT_SURFACE": "v3-compact"
      }
    }
  }
}
