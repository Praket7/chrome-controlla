{
  "name": "chrome-controlla-reference-runner",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:clients": "node tests/clients/check-configs.mjs",
    "check:apps": "node apps/check-phase8-briefs.mjs",
    "check:bench": "node --test bench/phase10-pilot.test.mjs bench/analysis/phase10-analysis.test.mjs bench/analysis/offline-task-harness.test.mjs && node scripts/check-phase10-heldout.mjs && python3 bench/phase6_compare.py",
    "prepare:release-candidate": "node scripts/prepare-release-candidate.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
